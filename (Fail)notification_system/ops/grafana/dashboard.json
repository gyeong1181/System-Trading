{
  "title": "Full Option Signal Monitor",
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "오늘 발송 신호",
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(rate(signal_sent_total[1d]))"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "graph",
      "title": "점수 분포",
      "targets": [
        {
          "refId": "B",
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.5, sum(rate(signal_score_bucket[6h])) by (le))"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}
    },
    {
      "type": "table",
      "title": "최근 신호 요약",
      "targets": [
        {
          "refId": "C",
          "datasource": "Postgres",
          "rawSql": "SELECT timestamp, symbol, timeframe, score, grade, risk_reward FROM signals ORDER BY timestamp DESC LIMIT 20",
          "format": "table"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "symbol",
        "type": "query",
        "datasource": "Postgres",
        "refresh": 1,
        "query": "SELECT DISTINCT symbol FROM signals ORDER BY 1"
      }
    ]
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  }
}
