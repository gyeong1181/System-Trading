# Python 관련 무시 목록
__pycache__/
*.pyc
*.pyd
*.pyo
venv/  # 가상 환경 폴더 (매우 중요합니다. Git에 올리지 마세요!)

# 로그 파일 (자동으로 생성되는 로그 파일)
*.log

# API 키 및 민감한 설정 (절대 GitHub에 올리면 안 됩니다!)
config.py # <--- API 키가 이 파일에 직접 있다면 반드시 무시해야 합니다.
          # 만약 config.py 대신 .env 파일에 키를 넣는다면, 아래 .env를 무시하면 됩니다.
.env      # .env 파일을 사용한다면 이 줄을 추가합니다.

