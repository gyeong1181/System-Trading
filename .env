# Binance API 설정 (실거래용)
# Binance Futures에서 API 키를 생성하고 여기에 입력하세요
# 주의: 실제 키는 절대 Git에 커밋하지 마세요!
BINANCE_API_KEY=HwgEc343fV4UBdIEUq30yiGSJWvIKbetd6YubhoB68LP2PVGZtyomULlKSyvnqVH
