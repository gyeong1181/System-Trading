[Unit]
Description=Sync trading env files from AWS SSM Parameter Store
After=docker.service network-online.target
Wants=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sync-trading-env.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
