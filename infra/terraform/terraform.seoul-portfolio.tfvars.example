aws_region         = "ap-northeast-2"
project_name       = "quant-fleet-seoul-portfolio"
instance_type      = "t3.small"
key_name           = "your-seoul-keypair"
ssh_allowed_cidrs  = ["YOUR_PUBLIC_IP/32"]
http_allowed_cidrs = ["0.0.0.0/0"]

enable_monitoring_ports = true
monitoring_allowed_cidrs = [
  "YOUR_PUBLIC_IP/32"
]

extra_tags = {
  Owner = "gyeong1181"
  Env   = "portfolio"
  Role  = "seoul-portfolio"
}

strategy_stack_dir          = "/opt/trading-stack"
deploy_strategy_stack       = false
enable_psar_container       = true
enable_okx_qqq_container    = false
enable_okx_xau_container    = false

use_ssm_env          = true
ssm_parameter_prefix = "/trading/seoul-portfolio"
ssm_kms_key_arn      = ""

psar_rsi_image = "ghcr.io/gyeong1181/quant-fleet-core:latest"
okx_qqq_image  = ""
okx_xau_image  = ""
