# Copy to: scripts/ssm-secrets.local.env (do not commit)
# Then run:
# AWS_REGION=us-west-2 SSM_PREFIX=/trading/prod ./scripts/bootstrap-ssm-from-file.sh scripts/ssm-secrets.local.env

# Optional: GHCR credentials for private image pull
GHCR_USERNAME=REPLACE_ME
GHCR_TOKEN=REPLACE_ME

# PSAR
PSAR_EXECUTION_MODE=LIVE
PSAR_TV_WEBHOOK_SECRET=REPLACE_ME
PSAR_BINANCE_API_KEY=REPLACE_ME
PSAR_BINANCE_API_SECRET=REPLACE_ME
PSAR_TELEGRAM_BOT_TOKEN=REPLACE_ME
PSAR_TELEGRAM_CHAT_ID=REPLACE_ME

# OKX QQQ
OKX_QQQ_API_KEY=REPLACE_ME
OKX_QQQ_API_SECRET=REPLACE_ME
OKX_QQQ_API_PASSPHRASE=REPLACE_ME
OKX_QQQ_TELEGRAM_BOT_TOKEN=REPLACE_ME
OKX_QQQ_TELEGRAM_CHAT_ID=REPLACE_ME

# OKX XAU
OKX_XAU_API_KEY=REPLACE_ME
OKX_XAU_API_SECRET=REPLACE_ME
OKX_XAU_API_PASSPHRASE=REPLACE_ME
OKX_XAU_TELEGRAM_BOT_TOKEN=REPLACE_ME
OKX_XAU_TELEGRAM_CHAT_ID=REPLACE_ME
