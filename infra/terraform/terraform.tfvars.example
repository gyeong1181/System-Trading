aws_region         = "ap-northeast-2"
project_name       = "psar-rsi-bot"
instance_type      = "t3.small"
key_name           = "your-keypair-name"
ssh_allowed_cidrs  = ["YOUR_PUBLIC_IP/32"]
http_allowed_cidrs = ["0.0.0.0/0"]

enable_monitoring_ports = false
monitoring_allowed_cidrs = [
  "YOUR_PUBLIC_IP/32"
]

extra_tags = {
  Owner = "gyeong1181"
  Env   = "prod"
}
