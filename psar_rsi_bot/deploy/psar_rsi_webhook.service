[Unit]
Description=PSAR RSI Webhook Executor
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/systemTrading/psar_rsi_bot
EnvironmentFile=/home/ec2-user/systemTrading/.env
ExecStart=/usr/bin/uvicorn webhook_server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
