# .env example (do not commit real secrets)

# Binance API (required for real trading)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# PSAR + EMA200 + RSI strategy
PSAR_RSI_SYMBOL=BTCUSDT
PSAR_RSI_SYMBOLS=BTCUSDT,SOLUSDT
PSAR_RSI_INTERVAL=1h
PSAR_RSI_RISK_PCT=1.0
PSAR_RSI_RR=2.0
PSAR_RSI_SWING_LOOKBACK=5
PSAR_RSI_LEVERAGE=1.0
PSAR_RSI_PAPER_MODE=true
PSAR_RSI_EXIT_ON_FLIP=true

# Risk/operation controls
# Per-symbol max notional caps (ex: BTCUSDT:120,SOLUSDT:60)
PSAR_RSI_MAX_NOTIONALS=
PSAR_RSI_RESERVE=20
PSAR_RSI_MARGIN_BUFFER=0.05
PSAR_RSI_ALERT_COOLDOWN_SEC=900

# TradingView Webhook Executor (new)
TV_WEBHOOK_SECRET=change_me
TV_ALLOWED_SYMBOLS=BTCUSDT,SOLUSDT
TV_ALLOWED_TIMEFRAMES=1h
TV_ALLOWED_TIMEFRAMES_BY_SYMBOL=BTCUSDT:1h,SOLUSDT:1h
EXECUTION_MODE=RECEIVE_ONLY  # RECEIVE_ONLY | DRY_RUN | LIVE
LEVERAGE_DEFAULT=1
ORDER_SIZING_MODE=EFFECTIVE_LEVERAGE  # FIXED | EQUITY_PCT | EFFECTIVE_LEVERAGE
TOTAL_TARGET_LEVERAGE=1.5
OPERATING_CAPITAL_RATIO=0.8
SYMBOL_WEIGHTS=BTCUSDT:0.6,SOLUSDT:0.4
PRESET_SYMBOL_LEVERAGE=5
BTC_ORDER_USDT=60
SOL_ORDER_USDT=40
BTC_ORDER_EQUITY_PCT=0.6
SOL_ORDER_EQUITY_PCT=0.4
SL_PCT_BTC=0.02
SL_PCT_SOL=0.025
RESERVE_USDT=20
MARGIN_BUFFER=0.05
CLOSE_BEFORE_REVERSE=true
DB_PATH=psar_rsi_bot/data/bot.db
